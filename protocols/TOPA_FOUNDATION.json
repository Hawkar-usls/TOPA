{
  "schema": "janus.genesis.topa_foundation.v1.2",
  "id": "JANUS_TOPA_FOUNDATION_V1_2",
  "version": "1.2",
  "status": "ACTIVE_CANONICAL_EPISTEMIC_FOUNDATION",
  "name": "TOPA",
  "motto": "NOTHING SUPERNATURAL — ONLY NATURE NOT YET UNDERSTOOD.",
  "owner_role": "GENESIS_DEFINES_ANOMALY_TO_HYPOTHESIS_LAWS",
  "purpose": "Give every JANUS agent a common evidence-bounded method for unusual, anomalous, paranormal-labeled or extraordinary reports: preserve raw provenance, distinguish report channels and firsthand/hearsay, test competing explanations, freeze predictions before outcomes, allow evidence to lower confidence, and preserve unresolved or falsified states without identity collapse.",
  "canonical_laws": [
    "UNKNOWN_IS_NOT_SUPERNATURAL",
    "ANOMALY_IS_A_QUESTION_NOT_A_CONCLUSION",
    "REPORT_IS_NOT_OBSERVATION",
    "OBSERVATION_IS_NOT_INTERPRETATION",
    "INTERPRETATION_IS_NOT_FACT",
    "NO_SOURCE_NO_POSITIVE_FACT",
    "FAILED_FETCH_IS_NOT_PROOF_OF_ABSENCE",
    "CORRELATION_IS_NOT_CAUSATION",
    "REPEATED_RETELLING_IS_NOT_INDEPENDENT_CONFIRMATION",
    "SAME_SOURCE_MULTI_AGENT_IS_NOT_INDEPENDENT_REPLICATION",
    "PEER_MESSAGE_IS_ROUTING_CONTEXT_NOT_EMPIRICAL_EVIDENCE",
    "SYMBOLIC_OR_ORACLE_OUTPUT_IS_CONTEXT_NOT_EMPIRICAL_PROOF",
    "ALTERNATIVE_HYPOTHESES_MUST_BE_PRESERVED",
    "DISCONFIRMING_EVIDENCE_MUST_BE_SEARCHABLE",
    "FALSIFICATION_ROUTE_REQUIRED_FOR_PROMOTION",
    "NEGATIVE_RESULTS_ARE_PRESERVED",
    "UNRESOLVED_IS_A_VALID_TERMINAL_STATE",
    "CONFIDENCE_MUST_NOT_EXCEED_EVIDENCE",
    "EXTRAORDINARY_INTERPRETATION_REQUIRES_PROPORTIONATELY_STRONG_EVIDENCE",
    "MISSING_DATA_STAYS_MISSING",
    "AUDIENCE_SIZE_IS_NOT_CORROBORATION",
    "REPETITION_IS_NOT_INDEPENDENCE",
    "FAILED_TESTS_MUST_BE_ABLE_TO_LOWER_CONFIDENCE",
    "MUNDANE_EXPLANATIONS_ARE_TESTED_EARLY_NOT_ASSUMED_TRUE",
    "CLOSED_BELIEF_LOOP_MUST_RAISE_WARNING",
    "RAW_PROVENANCE_MUST_BE_PRESERVED",
    "CHANNEL_CLASSIFICATION_REQUIRED",
    "FIRSTHAND_AND_HEARSAY_MUST_BE_DISTINCT",
    "TIME_AND_LOCATION_MUST_BE_PRESERVED_WHEN_AVAILABLE",
    "CALL_OCCURRED_DOES_NOT_IMPLY_CLAIM_TRUE",
    "EMAIL_READ_ON_AIR_IS_NOT_A_CALL",
    "GUEST_CLAIM_IS_NOT_A_CALLER_CASE",
    "INSTITUTIONAL_STATUS_IS_PROVENANCE_NOT_TRUTH",
    "SELF_IDENTIFIED_SOURCE_IS_NOT_AUTHENTICATED",
    "MODELS_MAY_NOT_REWRITE_RAW_LEDGER",
    "PREDICTIONS_MUST_BE_FROZEN_BEFORE_OUTCOME_SCORING",
    "NO_POST_HOC_REDEFINITION_TO_SAVE_A_FAILED_PREDICTION",
    "I_DO_NOT_KNOW_IS_A_VALID_OUTPUT"
  ],
  "claim_pipeline": [
    "RAW_REPORT",
    "PRESERVE_RAW_PROVENANCE",
    "CHANNEL_CLASSIFICATION",
    "FIRSTHAND_HEARSAY_CLASSIFICATION",
    "TIME_LOCATION_CAPTURE",
    "SOURCE_CHECK",
    "NORMALIZE_CLAIM_WITHOUT_REWRITING_RAW_LEDGER",
    "CLAIM_DECOMPOSITION",
    "OBSERVATION_INTERPRETATION_SPLIT",
    "COMPETING_HYPOTHESES",
    "MUNDANE_FIRST_PASS",
    "PREDICTION_FREEZE_IF_APPLICABLE",
    "FALSIFIERS_AND_TESTS",
    "SOURCE_BOUND_EVIDENCE",
    "CORROBORATION_AND_SOURCE_INDEPENDENCE_CHECK",
    "ADVERSARIAL_DISCONFIRMATION_PASS",
    "PREDICTION_DEADLINE_SCORE_IF_APPLICABLE",
    "CONFIDENCE_UPDATE",
    "STATUS_ASSIGNMENT",
    "APPEND_ONLY_MEMORY"
  ],
  "provenance_channels": [
    "DIRECT_OBSERVATION",
    "FIRSTHAND_REPORT",
    "HEARSAY_REPORT",
    "PEER_MESSAGE",
    "GUEST_CLAIM",
    "LISTENER_EMAIL",
    "HOST_STATEMENT",
    "SYMBOLIC_CONTEXT",
    "MODEL_INFERENCE"
  ],
  "allowed_statuses": [
    "UNVERIFIED_REPORT",
    "SOURCE_BOUND_OBSERVATION",
    "INFERRED_HYPOTHESIS",
    "SYMBOLIC_CONTEXT",
    "SUPPORTED_WITHIN_BOUND",
    "WEAKENED",
    "FALSIFIED",
    "UNRESOLVED"
  ],
  "required_claim_fields": [
    "claim_id",
    "origin_agent_id",
    "claim_text",
    "claim_kind",
    "source_pointers",
    "provenance_channel",
    "firsthand_status",
    "alternative_hypotheses",
    "falsification_tests",
    "status",
    "confidence"
  ],
  "promotion_gate": {
    "positive_claim_requires_source_bound_evidence": true,
    "extraordinary_interpretation_may_be_promoted_by_consensus": false,
    "peer_message_may_be_promoted_as_fact": false,
    "symbolic_or_oracle_context_may_be_promoted_as_fact": false,
    "same_source_seen_by_many_agents_counts_as_independent_replication": false,
    "unresolved_may_remain_unresolved": true,
    "negative_or_falsifying_result_must_survive": true,
    "missing_data_may_be_imputed_as_evidence": false,
    "audience_size_counts_as_corroboration": false,
    "repetition_counts_as_independence": false,
    "failed_test_may_lower_confidence": true,
    "favored_hypothesis_requires_possible_confidence_lowering_observation": true,
    "channel_may_be_silently_reclassified": false,
    "hearsay_may_be_promoted_to_firsthand": false,
    "institutional_role_counts_as_truth": false,
    "self_identification_authenticates_source": false,
    "post_hoc_prediction_redefinition_allowed": false,
    "raw_ledger_may_be_rewritten_by_model": false
  },
  "prediction_gate": {
    "applies_when_claim_contains_future_testable_outcome": true,
    "freeze_before_deadline": [
      "claim_text",
      "prediction_timestamp",
      "deadline_or_window",
      "success_criterion",
      "failure_criterion",
      "allowed_tolerance"
    ],
    "score_after_deadline": [
      "PASS",
      "FAIL",
      "PARTIAL_WITH_PREDECLARED_TOLERANCE",
      "UNSCORABLE_TOO_VAGUE",
      "UNRESOLVED_MISSING_OUTCOME_DATA"
    ],
    "post_hoc_redefinition_allowed": false,
    "failed_prediction_must_be_able_to_lower_confidence": true
  },
  "closed_belief_loop_alarm": {
    "name": "CLOSED_BELIEF_LOOP_WARNING",
    "trigger": "No possible observation, test or source result is named that could lower confidence in the favored interpretation.",
    "effect": "Block promotion beyond hypothesis/context until a disconfirming route exists.",
    "does_not_mean": "The claim is false; only that the current belief loop is not falsifiable."
  },
  "kenshi_binding": {
    "rule": "SYNC_STATE_NOT_IDENTITY",
    "fact_clustering_allowed": true,
    "agent_identity_clustering_allowed": false,
    "provenance_may_be_erased_during_handoff": false
  },
